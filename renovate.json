{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise itself, pinned in the CI workflow so mise:check cannot drift",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+version:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "additionalBranchPrefix": "",
      "postUpgradeTasks": {
        "commands": ["mise lock"],
        "fileFilters": ["mise.lock"],
        "executionMode": "branch"
      }
    }
  ]
}
